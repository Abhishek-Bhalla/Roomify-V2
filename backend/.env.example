PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.lbuku8g.mongodb.net/<dbname>
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRE=7d
NODE_ENV=development
ALLOWED_ORIGINS=https://your-vercel-project.vercel.app

# Email Configuration
#
# Provider chain (default): Resend → SendGrid → Brevo SMTP → Gmail SMTP
# Each provider only fires if its own env vars are present.
#
# To force the chain to a single provider (e.g. for presentations or
# day-2 demo when free tiers are exhausted), set EMAIL_PROVIDER to one
# of: resend | sendgrid | brevo | gmail
#
# EMAIL_PROVIDER=gmail   ← short-circuits straight to Gmail SMTP, ignores
#                          Resend/SendGrid/Brevo entirely.
#
# If EMAIL_PROVIDER is unset and Resend is also unset but EMAIL_USER +
# EMAIL_PASS are set, Gmail is auto-promoted to the top.
#
# --- Resend (HTTPS, 100/day free) ---
# RESEND_API_KEY=
#
# --- SendGrid (HTTPS, 100/day free) ---
# SENDGRID_API_KEY=
# SENDGRID_FROM=
#
# --- Brevo SMTP (300/day free) ---
# BREVO_SMTP_HOST=smtp-relay.brevo.com
# BREVO_USER=
# BREVO_PASS=
# BREVO_FROM=
#
# --- Gmail SMTP (~500/day from a personal Gmail) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=your-email@gmail.com
EMAIL_FROM_NAME=CampusSpace System

# Optional: override the system display name used in the From header.
